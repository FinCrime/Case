<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#101827">
<title>CaseTrack — Productivity</title>

<style>
:root {
--bg:#0b1220;
--panel:#141f30;
--panel2:#1b2940;
--text:#eef4ff;
--muted:#9aabc3;
--accent:#64d6a3;
--line:#2a3a52;
--red:#ff7f87;
}

* { box-sizing:border-box; }

body {
margin:0;
background:linear-gradient(160deg,#101b2d,#0b1220 55%);
color:var(--text);
font:15px system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
min-height:100vh;
}

.wrap {
max-width:760px;
margin:auto;
padding:20px 16px 40px;
}

header {
display:flex;
justify-content:space-between;
align-items:center;
margin:8px 0 20px;
}

.brand {
font-weight:800;
font-size:22px;
}

.brand span { color:var(--accent); }

.date {
color:var(--muted);
font-size:12px;
}

.card {
background:rgba(20,31,48,.96);
border:1px solid var(--line);
border-radius:18px;
padding:17px;
margin:12px 0;
}

.eyebrow {
color:var(--muted);
font-size:11px;
text-transform:uppercase;
letter-spacing:1.2px;
font-weight:700;
}

.big {
font-size:54px;
line-height:1.05;
font-weight:800;
margin:8px 0 4px;
}

.sub { color:var(--muted); font-size:13px; }

/* EXTRA LARGE CASE COMPLETED BUTTON */

.primary {
width:100%;
min-height:112px;
border:0;
border-radius:19px;
background:var(--accent);
color:#092018;
font-size:25px;
font-weight:850;
padding:32px 20px;
margin-top:16px;
cursor:pointer;
box-shadow:0 6px 0 #159b78;
letter-spacing:.2px;
}

.primary:active {
transform:translateY(3px);
box-shadow:0 3px 0 #159b78;
}

.secondary,.ghost,.danger {
border:1px solid var(--line);
border-radius:12px;
padding:11px 13px;
background:var(--panel2);
color:var(--text);
font-weight:650;
cursor:pointer;
}

.danger {
color:var(--red);
border-color:#75404b;
background:#2a1d2a;
}

.row {
display:flex;
gap:10px;
align-items:center;
}

.row>* { flex:1; }

.grid {
display:grid;
grid-template-columns:repeat(2,1fr);
gap:10px;
}

.metric {
background:var(--panel2);
border-radius:13px;
padding:13px;
}

.metric strong {
display:block;
font-size:24px;
margin-top:5px;
}

.metric small { color:var(--muted); }

.progress {
height:9px;
background:#27364b;
border-radius:20px;
overflow:hidden;
margin:12px 0 5px;
}

.bar {
height:100%;
background:var(--accent);
width:0%;
border-radius:20px;
}

input,select {
width:100%;
background:#0d1726;
border:1px solid var(--line);
border-radius:10px;
color:var(--text);
padding:12px;
font:inherit;
margin-top:6px;
}

label {
font-size:12px;
color:var(--muted);
display:block;
margin:10px 0;
}

.section-title {
font-size:17px;
font-weight:750;
margin:0 0 12px;
}

.mini {
font-size:12px;
color:var(--muted);
line-height:1.5;
}

.table {
width:100%;
border-collapse:collapse;
font-size:13px;
}

.table td,.table th {
padding:9px 5px;
border-bottom:1px solid var(--line);
text-align:left;
}

.table th {
color:var(--muted);
font-weight:600;
}

.actions {
display:flex;
gap:8px;
flex-wrap:wrap;
margin-top:12px;
}

.actions button { flex:1; }

.notice {
background:#102b2b;
border:1px solid #245747;
color:#baf3d8;
padding:10px 12px;
border-radius:11px;
font-size:12px;
margin-top:10px;
}

footer {
text-align:center;
color:var(--muted);
font-size:11px;
padding:18px 8px;
}

@media(min-width:600px) {
.big { font-size:64px; }
.grid { grid-template-columns:repeat(4,1fr); }
}
</style>
</head>

<body>

<div class="wrap">

<header>
<div class="brand">Case<span>Track</span></div>
<div class="date" id="today"></div>
</header>

<section class="card">

<div class="eyebrow">Completed cases today</div>

<div class="big" id="caseCount">0</div>

<div class="sub">
Tap once after a case is successfully submitted.
</div>

<button class="primary" id="addCase">
＋ CASE COMPLETED
</button>

<div class="actions">
<button class="secondary" id="undo">Undo last</button>
<button class="ghost" id="shiftToggle">Start shift</button>
</div>

<div class="notice">
Only counts your button taps. It does not connect to or read your workplace screening system.
</div>

</section>

<section class="card">

<div class="section-title">Live performance</div>

<div class="grid">

<div class="metric">
<small>Cases / hour</small>
<strong id="rate">0.0</strong>
</div>

<div class="metric">
<small>Average handling time</small>
<strong id="aht">—</strong>
</div>

<div class="metric">
<small>Shift duration</small>
<strong id="duration">0m</strong>
</div>

<div class="metric">
<small>Target progress</small>
<strong id="targetPct">0%</strong>
</div>

</div>

<div class="row" style="margin-top:14px">

<label>
Hourly target
<input id="target" type="number" min="1" value="40">
</label>

<label>
Shift start (optional)
<input id="startTime" type="time">
</label>

</div>

<div class="progress">
<div class="bar" id="targetBar"></div>
</div>

<div class="mini" id="targetText">
0 of 40 cases in the last 60 minutes
</div>

</section>

<section class="card">

<div class="section-title">Hourly breakdown</div>

<div class="mini" style="margin-bottom:8px">
Cases are grouped by the hour you tapped Case Completed.
</div>

<div id="hourly">
<div class="mini">No cases recorded yet.</div>
</div>

</section>

<section class="card">

<div class="section-title">QC score calculator</div>

<div class="mini">
Clean = 100%, one minor = 37%, two minors = 67%,
3+ errors or OD error = 0%.
</div>

<div class="grid">

<label>Clean cases
<input id="qcClean" type="number" min="0" value="0">
</label>

<label>One minor error
<input id="qcOne" type="number" min="0" value="0">
</label>

<label>Two minor errors
<input id="qcTwo" type="number" min="0" value="0">
</label>

<label>3+ errors
<input id="qcThree" type="number" min="0" value="0">
</label>

<label>OD errors
<input id="qcOd" type="number" min="0" value="0">
</label>

</div>

<div class="row" style="align-items:end">

<div>
<div class="eyebrow">Calculated QC score</div>
<div class="big" style="font-size:38px" id="qcScore">—</div>
<div class="mini" id="qcCount">0 QC cases entered</div>
</div>

<button class="secondary" id="resetQc">Reset QC</button>

</div>

</section>

<section class="card">

<div class="section-title">End-of-day record</div>

<div class="mini">
Save your daily case count and QC performance at the end of your shift.
</div>

<div class="actions">
<button class="primary" id="saveEod" style="margin-top:0">
SAVE TODAY'S EOD COUNT
</button>
</div>

<div class="notice" id="eodStatus">
Today's count has not been saved yet.
</div>

<div style="margin-top:16px" class="section-title">
Daily history
</div>

<div id="history">
<div class="mini">No EOD records saved yet.</div>
</div>

</section>

<section class="card">

<div class="section-title">Data & privacy</div>

<div class="mini">
Your records are stored in this browser on this phone.
No customer names, case IDs or confidential screening information are collected.
Clearing browser data may erase your records.
</div>

<div class="actions">
<button class="secondary" id="export">Export history CSV</button>
<button class="danger" id="resetDay">Reset today's cases</button>
</div>

</section>

<footer>
CaseTrack · Personal productivity tracker
</footer>

</div>

<script>

const $ = id => document.getElementById(id);

const dayKey = () => {
const d = new Date();
return [
d.getFullYear(),
String(d.getMonth()+1).padStart(2,'0'),
String(d.getDate()).padStart(2,'0')
].join('-');
};

let state = {
date:dayKey(),
events:[],
shiftStart:null,
shiftEnd:null
};

const storageKey = 'casetrack_v1_' + dayKey();
const historyKey = 'casetrack_eod_history_v1';
const prefsKey = 'casetrack_prefs_v1';

let history = {};

function loadHistory() {
try {
history = JSON.parse(localStorage.getItem(historyKey)||'{}');
} catch(e) {
history = {};
}
}

function saveHistory() {
localStorage.setItem(historyKey,JSON.stringify(history));
renderHistory();
}

function load() {
try {
const s = localStorage.getItem(storageKey);
if(s) state = JSON.parse(s);
} catch(e) {}
}

function save() {
localStorage.setItem(storageKey,JSON.stringify(state));
render();
}

function fmtDuration(ms) {
if(!Number.isFinite(ms)||ms<0) return '—';
let m = Math.round(ms/60000);
return m>=60
? `${Math.floor(m/60)}h ${m%60}m`
: `${m}m`;
}

function hourLabel(d) {
return d.toLocaleTimeString([],{
hour:'numeric',
hour12:true
});
}

function getQcSnapshot() {

const vals = [
'qcClean','qcOne','qcTwo','qcThree','qcOd'
].map(id=>Math.max(0,Number($(id).value)||0));

const [clean,oneMinor,twoMinor,threePlus,od] = vals;

const total = vals.reduce((a,b)=>a+b,0);

return {
clean,
oneMinor,
twoMinor,
threePlus,
od,
total,
score:total
?(clean*100+oneMinor*37+twoMinor*67)/total
:null
};

}

function calcQc() {

const qc = getQcSnapshot();

$('qcScore').textContent =
qc.score===null?'—':qc.score.toFixed(2)+'%';

$('qcCount').textContent =
`${qc.total} QC cases entered`;

}

function renderHistory() {

const dates = Object.keys(history).sort().reverse();

if(!dates.length) {
$('history').innerHTML =
'<div class="mini">No EOD records saved yet.</div>';
return;
}

$('history').innerHTML =
'<div style="overflow-x:auto"><table class="table"><thead><tr><th>Date</th><th>Cases</th><th>QC</th><th>Shift</th></tr></thead><tbody>'+
dates.map(date=>{
const r=history[date];

return `<tr>
<td>${date}</td>
<td>${r.cases}</td>
<td>${r.qcScore===null?'—':r.qcScore.toFixed(2)+'%'}</td>
<td>${r.shiftDuration||'—'}</td>
</tr>`;
}).join('')+
'</tbody></table></div>';

}

function render() {

$('today').textContent =
new Date().toLocaleDateString([],{
weekday:'short',
day:'numeric',
month:'short',
year:'numeric'
});

$('caseCount').textContent = state.events.length;

const now = Date.now();

const start =
state.shiftStart ||
(state.events[0]?.ts ?? now);

const elapsed = Math.max(0,now-start);

const rate = elapsed>0
?state.events.length/(elapsed/3600000)
:0;

$('rate').textContent = rate.toFixed(1);

const gaps = state.events.slice(1)
.map((e,i)=>e.ts-state.events[i].ts)
.filter(x=>x>0);

$('aht').textContent = gaps.length
?fmtDuration(gaps.reduce((a,b)=>a+b,0)/gaps.length)
:'—';

$('duration').textContent =
state.shiftStart
?fmtDuration(now-state.shiftStart)
:'0m';

const target = Math.max(1,Number($('target').value)||40);

const thisHour = state.events.filter(
e=>now-e.ts<3600000
).length;

const pct = Math.min(100,thisHour/target*100);

$('targetPct').textContent = Math.round(pct)+'%';
$('targetBar').style.width = pct+'%';

$('targetText').textContent =
`${thisHour} of ${target} cases in the last 60 minutes`;

$('shiftToggle').textContent =
state.shiftStart&&!state.shiftEnd
?'End shift'
:state.shiftEnd
?'Shift ended'
:'Start shift';

$('undo').disabled = !state.events.length;

const saved = history[state.date];

$('eodStatus').textContent = saved
?`EOD saved for ${state.date}: ${saved.cases} cases. Saving again updates this date's record.`
:"Today's count has not been saved as an EOD record yet.";

const groups = {};

state.events.forEach(e=>{
const d = new Date(e.ts);
const k = d.getFullYear()+'-'+d.getMonth()+'-'+d.getDate()+'-'+d.getHours();

groups[k] = groups[k] || {
label:hourLabel(d),
count:0
};

groups[k].count++;
});

const vals = Object.values(groups).reverse();

$('hourly').innerHTML = vals.length
?'<table class="table"><thead><tr><th>Hour</th><th>Cases</th></tr></thead><tbody>'+
vals.map(v=>`<tr><td>${v.label}</td><td>${v.count}</td></tr>`).join('')+
'</tbody></table>'
:'<div class="mini">No cases recorded yet.</div>';

calcQc();
renderHistory();

}

function saveEod() {

const qc = getQcSnapshot();

const grouped = {};

state.events.forEach(e=>{
const d = new Date(e.ts);
const label = hourLabel(d);
grouped[label] = (grouped[label]||0)+1;
});

const duration = state.shiftStart
?fmtDuration((state.shiftEnd||Date.now())-state.shiftStart)
:'—';

history[state.date] = {
date:state.date,
cases:state.events.length,
shiftStart:state.shiftStart,
shiftEnd:state.shiftEnd,
shiftDuration:duration,
qcClean:qc.clean,
qcOneMinor:qc.oneMinor,
qcTwoMinor:qc.twoMinor,
qcThreePlus:qc.threePlus,
qcOd:qc.od,
qcTotal:qc.total,
qcScore:qc.score,
hourly:grouped,
savedAt:Date.now()
};

saveHistory();

$('eodStatus').textContent =
`EOD saved for ${state.date}: ${state.events.length} cases.`;

}

function loadPrefs() {

try {
const p = JSON.parse(localStorage.getItem(prefsKey)||'{}');

if(p.target) $('target').value = p.target;

['qcClean','qcOne','qcTwo','qcThree','qcOd']
.forEach(id=>{
if(p[id]!==undefined) $(id).value=p[id];
});

} catch(e) {}

}

function savePrefs() {

const p = {target:$('target').value};

['qcClean','qcOne','qcTwo','qcThree','qcOd']
.forEach(id=>p[id]=$(id).value);

localStorage.setItem(prefsKey,JSON.stringify(p));

}

$('addCase').addEventListener('click',()=>{
state.events.push({ts:Date.now()});
state.shiftEnd=null;
save();
if(navigator.vibrate) navigator.vibrate(35);
});

$('undo').addEventListener('click',()=>{
state.events.pop();
save();
});

$('shiftToggle').addEventListener('click',()=>{

if(!state.shiftStart||state.shiftEnd) {
state.shiftStart=Date.now();
state.shiftEnd=null;
} else {
state.shiftEnd=Date.now();
}

save();

});

$('target').addEventListener('input',()=>{
savePrefs();
render();
});

['qcClean','qcOne','qcTwo','qcThree','qcOd']
.forEach(id=>{
$(id).addEventListener('input',()=>{
savePrefs();
calcQc();
});
});

$('resetQc').addEventListener('click',()=>{
['qcClean','qcOne','qcTwo','qcThree','qcOd']
.forEach(id=>$(id).value=0);

savePrefs();
calcQc();
});

$('resetDay').addEventListener('click',()=>{
if(confirm("Delete today's case timestamps and shift times?")) {
state={
date:dayKey(),
events:[],
shiftStart:null,
shiftEnd:null
};
save();
}
});

$('saveEod').addEventListener('click',()=>{
if(confirm(`Save ${state.events.length} completed cases as today's EOD record?`)) {
saveEod();
}
});

$('export').addEventListener('click',()=>{

const rows = [[
'Date','Cases','Shift duration',
'Clean QC','One minor','Two minors',
'3+ errors','OD errors','QC cases',
'QC score','Saved at'
]];

Object.keys(history).sort().forEach(date=>{

const r = history[date];

rows.push([
r.date,
r.cases,
r.shiftDuration,
r.qcClean,
r.qcOneMinor,
r.qcTwoMinor,
r.qcThreePlus,
r.qcOd,
r.qcTotal,
r.qcScore===null?'':r.qcScore,
new Date(r.savedAt).toISOString()
]);

});

const csv = rows.map(r=>
r.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(',')
).join('\n');

const blob = new Blob([csv],{type:'text/csv'});

const a = document.createElement('a');
a.href = URL.createObjectURL(blob);
a.download = 'casetrack-daily-history.csv';
a.click();

URL.revokeObjectURL(a.href);

});

load();
loadHistory();
loadPrefs();
render();

setInterval(render,30000);

</script>
</body>
</html>
